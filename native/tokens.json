{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Republike design tokens — single source for both republike-ios and republike-android. The Phase 1 codegen script reads this and emits Tokens.swift + Tokens.kt.",

  "color": {
    "primary": {
      "$value": "#7B61FF",
      "$type": "color",
      "$description": "purple-main — primary brand color"
    },
    "primaryLight": {
      "$value": "#BFC2FF",
      "$type": "color"
    },
    "primarySoft": {
      "$value": "#CAC5E7",
      "$type": "color"
    },
    "primaryExtralight": {
      "$value": "#e9e8ff",
      "$type": "color"
    },
    "primaryGradientFrom": {
      "$value": "#9055ED",
      "$type": "color"
    },
    "primaryGradientTo": {
      "$value": "#775EF7",
      "$type": "color"
    },

    "accentRed": {
      "$value": "#FF0E83",
      "$type": "color"
    },
    "accentPink": {
      "$value": "#FF6161",
      "$type": "color"
    },
    "accentConsul": {
      "$value": "#FBDF9C",
      "$type": "color"
    },
    "accentConsulDeep": {
      "$value": "#F0CB66",
      "$type": "color"
    },

    "text": {
      "primary": {
        "$value": "#131721",
        "$type": "color"
      },
      "secondary": {
        "$value": "#4B5563",
        "$type": "color"
      },
      "tertiary": {
        "$value": "#9597A1",
        "$type": "color"
      },
      "onPrimary": {
        "$value": "#FFFFFF",
        "$type": "color"
      }
    },

    "surface": {
      "background": {
        "$value": "#F8F8FF",
        "$type": "color"
      },
      "card": {
        "$value": "#FFFFFF",
        "$type": "color"
      },
      "subtle": {
        "$value": "#F9F9F9",
        "$type": "color"
      },
      "divider": {
        "$value": "#E5E7EB",
        "$type": "color"
      },
      "dividerStrong": {
        "$value": "#D1D5DB",
        "$type": "color"
      }
    },

    "feedback": {
      "success": {
        "$value": "#10B981",
        "$type": "color"
      },
      "warning": {
        "$value": "#F59E0B",
        "$type": "color"
      },
      "error": {
        "$value": "#DC2626",
        "$type": "color"
      },
      "info": {
        "$value": "#3B82F6",
        "$type": "color"
      }
    }
  },

  "typography": {
    "fontFamily": {
      "main": {
        "$value": "TT Firs Neue",
        "$type": "fontFamily",
        "$description": "primary brand font — replaces RN's `font-main`"
      },
      "mono": {
        "$value": "SF Mono",
        "$type": "fontFamily"
      }
    },
    "fontSize": {
      "footnote": { "$value": 11, "$type": "dimension" },
      "caption":  { "$value": 12, "$type": "dimension" },
      "body":     { "$value": 15, "$type": "dimension" },
      "bodyL":    { "$value": 17, "$type": "dimension" },
      "headline": { "$value": 20, "$type": "dimension" },
      "title":    { "$value": 24, "$type": "dimension" },
      "titleL":   { "$value": 32, "$type": "dimension" },
      "display":  { "$value": 40, "$type": "dimension" }
    },
    "fontWeight": {
      "regular":   { "$value": 400, "$type": "fontWeight" },
      "medium":    { "$value": 500, "$type": "fontWeight" },
      "semibold":  { "$value": 600, "$type": "fontWeight" },
      "bold":      { "$value": 700, "$type": "fontWeight" }
    },
    "lineHeight": {
      "tight":  { "$value": 1.2, "$type": "number" },
      "normal": { "$value": 1.4, "$type": "number" },
      "loose":  { "$value": 1.6, "$type": "number" }
    }
  },

  "spacing": {
    "0":   { "$value": 0,  "$type": "dimension" },
    "1":   { "$value": 2,  "$type": "dimension" },
    "2":   { "$value": 4,  "$type": "dimension" },
    "3":   { "$value": 8,  "$type": "dimension" },
    "4":   { "$value": 12, "$type": "dimension" },
    "5":   { "$value": 16, "$type": "dimension" },
    "6":   { "$value": 20, "$type": "dimension" },
    "7":   { "$value": 24, "$type": "dimension" },
    "8":   { "$value": 32, "$type": "dimension" },
    "9":   { "$value": 40, "$type": "dimension" },
    "10":  { "$value": 48, "$type": "dimension" },
    "12":  { "$value": 64, "$type": "dimension" }
  },

  "radius": {
    "none":   { "$value": 0,  "$type": "dimension" },
    "sm":     { "$value": 4,  "$type": "dimension" },
    "md":     { "$value": 8,  "$type": "dimension" },
    "lg":     { "$value": 12, "$type": "dimension" },
    "xl":     { "$value": 16, "$type": "dimension" },
    "2xl":    { "$value": 24, "$type": "dimension" },
    "pill":   { "$value": 9999, "$type": "dimension" }
  },

  "elevation": {
    "card":   { "$value": "0 0 1px rgba(0,0,0,0.07), 0 0 20px rgba(0,0,0,0.05)", "$type": "shadow", "$description": "approx of RN .shadow-rpb + low-DPI hairline" },
    "sheet":  { "$value": "0 -4px 16px rgba(0,0,0,0.08)", "$type": "shadow" },
    "popover":{ "$value": "0 8px 24px rgba(0,0,0,0.12)", "$type": "shadow" }
  },

  "duration": {
    "fast":   { "$value": 150, "$type": "duration" },
    "normal": { "$value": 250, "$type": "duration" },
    "slow":   { "$value": 400, "$type": "duration" }
  }
}
